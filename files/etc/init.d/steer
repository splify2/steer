#!/bin/sh /etc/rc.common
# Движок steer: один процесс — демон steerd (docs/architecture.md, раздел 4а).
#
# Всё делает демон: применение спеки при старте (--apply), сторож выходов (--watch), помощники
# выходов и резолвер (--supervise), освежение снимка status раз в пять минут. procd держит один
# экземпляр с respawn; reload — запрос в сокет демона клиентом `steer reload`: демон сверяет
# спеку с применённой, а применённое — с ядром, и трогает только изменившееся или разошедшееся
# (набор правил, маршрутизацию выходов, помощников, таблицу резолвера).
#
# START — после подъёма сети (таблицам маршрутизации выходов нужно их устройство), но раньше
# всего, что несёт трафик клиентов: после перезагрузки у клиента не должно быть мгновения без
# маршрутизации по правилам.
START=94
STOP=11
USE_PROCD=1
# Их зовут splify2 (reload_dnsd, reload_zapret) и триггер сети (reapply). Все три значат одно —
# «демон, перечитай спеку»: что именно трогать, решает сверка.
EXTRA_COMMANDS="reload_dnsd reload_zapret reapply"
EXTRA_HELP="	reload_zapret	Перечитать спеку, не трогая туннели
	reload_dnsd	Перечитать списки резолвером, не снимая правил
	reapply		Сверить правила и маршруты в ядре со спекой и вернуть разошедшееся"

# Спека — spec.json или spec.yaml рядом (спека v2 в YAML, docs/spec-v2.md, «Файл спеки»). Движку
# передаётся путь spec.json и тогда, когда лежит только spec.yaml: этот путь по умолчанию он
# сам заменяет на spec.yaml (plat_spec_default), а обе сразу — отказ «две спеки». Проверять же,
# есть ли спека, здесь нужно по обоим именам (steer_spec_present).
SPEC=/etc/steer/spec.json
SPEC_YAML=/etc/steer/spec.yaml
# Абсолютные пути: команду экземпляра запускает procd, а не эта оболочка, и его PATH — не наш.
STEERD=/usr/sbin/steerd
STEER=/usr/sbin/steer

boot() {
    # `nft -f` нужны собственные таблицы fw4; на холодной загрузке он может ещё подниматься.
    # Применение при старте демона идемпотентно, а respawn procd повторит его при сбое.
    start "$@"
}

start_service() {
    # Без спеки демон тоже нужен: splify2 кладёт спеку и зовёт `steer apply`, и клиент отдаёт
    # её демону — тот сохраняет, применяет и поднимает помощников. Демон без спеки отвечает
    # status тем же отказом, что движок, и ничего не применяет.
    procd_open_instance steerd
    procd_set_param command "$STEERD" daemon --watch --supervise --apply --spec "$SPEC"
    procd_set_param respawn 3600 5 0
    # SIGTERM демону гасит помощников по одному (3 с каждому, 10 с всем) — procd не должен убить
    # его SIGKILL раньше, иначе помощники остались бы без присмотра.
    procd_set_param term_timeout 15
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Правила снимает steerd down — после того, как демон вышел: пока он жив, сторож мог бы
# привязать таблицу выхода заново посреди снятия. procd гасит экземпляр после stop_service
# (procd_kill), поэтому здесь запоминается pid, а ждать и снимать — в service_stopped.
#
# Демон мог только что упасть (kill -9, OOM), и procd ещё не поднял его снова: тогда pid пуст,
# ждать некого, а резолвер, переживший демона, ждёт нового до 60 с. Его гасит тот же `steerd
# down` — находит по управляющему сокету каталога состояния (src/dnsd/adopt.c).
stop_service() {
    _steerd_pid="$(ubus call service list '{"name":"steer"}' 2>/dev/null |
                   jsonfilter -e '@.steer.instances.steerd.pid' 2>/dev/null)"
}

service_stopped() {
    _i=0
    while [ -n "${_steerd_pid:-}" ] && [ -d "/proc/$_steerd_pid" ] && [ $_i -lt 20 ]; do
        sleep 1
        _i=$((_i + 1))
    done
    if [ -x "$STEERD" ]; then
        "$STEERD" down
        return 0
    fi
    # Бинарника уже нет (удаление пакета): то же, что делает down, литералами. Таблицы движка
    # живут отдельно от fw4, поэтому снятие не задевает чужой firewall; маска метки объявлена
    # в контракте (docs/contract-v1.md) и меняться не должна. Таблиц ip/ip6 steer на роутере не
    # бывает: их ставила только раскладка для ядер без nat в inet (до 5.2, телефон).
    for t in "inet steer" "inet steer_obfs"; do
        nft delete table $t 2>/dev/null
    done
    for t in $(awk '{print $3}' /var/lib/steer/registry 2>/dev/null); do
        ip route flush table "$t" 2>/dev/null
    done
    for m in $(awk '{print $2}' /var/lib/steer/registry 2>/dev/null); do
        while ip rule del fwmark "0x$m/0x0ff00000" 2>/dev/null; do :; done
    done
}

# Снят ли автозапуск: ссылка в /etc/rc.d — это и есть запись человеческого решения «не
# поднимать» («Остановить всё» в splify2 делает stop и disable).
steer_autostart_off() {
    [ -d /etc/rc.d ] || return 1        # не OpenWrt-подобная система — не гадаем
    set -- /etc/rc.d/S[0-9][0-9]steer
    [ -e "$1" ] && return 1
    return 0
}

# Запрос reload демону. Код 3 у клиента — демон не отвечает (не запущен); тогда 1, и решает
# вызывающий. Отказ самого reload (спека не прошла проверку) демон уже описал в stderr.
#
# Stderr клиента придерживается: при коде 3 он говорит «демон движка не отвечает», а вызывающий
# следом обычно поднимает службу — в консоли это читалось тревогой там, где всё штатно. Строку
# печатает steer_nodaemon_say — только там, где службу поднимать не будут.
steer_reload() {
    { _steer_err="$("$STEER" reload --spec "$SPEC" 2>&1 1>&3)"; _steer_rc=$?; } 3>&1
    if [ "$_steer_rc" -ne 3 ]; then
        [ -n "$_steer_err" ] && printf '%s\n' "$_steer_err" >&2
        return 0
    fi
    return 1
}

steer_nodaemon_say() {
    [ -n "${_steer_err:-}" ] && printf '%s\n' "$_steer_err" >&2
    return 0
}

# Перечитать списки резолвером. Зовут его splify2 после «Применить» и ночное обновление списков
# — как «перечитай, если работаешь». Демон отдаёт резолверу новую таблицу, только если
# изменились она сама или файлы её списков, и процесс резолвера тот же: DNS не пропадает.
reload_dnsd() {
    steer_reload && return 0
    if steer_autostart_off; then
        # Человек выключил движок — и это сильнее: ночное обновление списков не должно
        # поднимать его молча.
        steer_nodaemon_say
        echo "steer: автозапуск снят — ядро не поднимаю"
        return 0
    fi
    start
}

# То же «перечитай спеку», но службу не поднимает: splify2 зовёт её после смены стратегий обхода,
# а демон, поднявшись, прочтёт спеку сам. Сказать об этом стоит, только если службу не поднимут.
reload_zapret() {
    steer_reload && return 0
    steer_autostart_off && steer_nodaemon_say
    return 0
}

reload_service() {
    steer_reload && return 0
    if steer_autostart_off; then
        steer_nodaemon_say
        return 0
    fi
    start
}

# Сверить ядро со спекой после смены настройки сети (триггер ниже).
#
# Набор правил от /etc/config/network не зависит: клиенты берутся из спеки — именем устройства
# (iifname) или явным from_default. Но правка сети — это `network reload`,
# после которого netifd пересоздаёт интерфейсы (ядро снимает маршруты через них), а скрипты,
# повешенные на смену сети (mwan3, pbr и им подобные), могут переписать ip rule, таблицы
# маршрутизации и наборы правил nft. reload демона на неизменной спеке — это сверка с ядром
# (src/daemon/recon.c, «СВЕРКА С ЯДРОМ»): набор правил, правила и маршруты выходов, которые
# разошлись с применённым, он возвращает, а когда всё на месте — в ядро не идёт. Стоит это одного
# плана (компиляция спеки ребёнком демона) на правку сети — событие редкое.
#
# Нужен ли триггер вообще. Маршруты и правила выходов после пересоздания интерфейсов вернёт и
# без него проход сторожа — по событию hotplug (95-steer: SIGHUP, внеочередной проход) или через
# минуту, — а снятое ip rule при занятой таблице сразу вернёт страж правил демона. Чего не видит
# ни тот, ни другой, — набор правил nft: изменённую в нём цепочку или правило канала без
# триггера не вернёт никто до ручного apply. Поэтому триггер остаётся — как сверка, а не как
# «пересобрать». Демона нет — применить движком.
steer_spec_present() {
    [ -f "$SPEC" ] || [ -f "$SPEC_YAML" ]
}

reapply() {
    steer_spec_present || return 0
    steer_reload && return 0
    "$STEERD" apply --spec "$SPEC" || echo "steer: apply failed — see the message above"
}

service_triggers() {
    # Подписка на /etc/config/network: он меняется, когда правят интерфейсы и мост локальной
    # сети. Подъём и падение интерфейсов приходят не сюда, а в /etc/hotplug.d/iface/95-steer.
    procd_open_trigger
    procd_add_config_trigger "config.change" "network" /etc/init.d/steer reapply
    procd_close_trigger
}
