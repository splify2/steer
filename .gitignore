# Артефакты сборки — но НЕ каталог build целиком: в нём живут Dockerfile и
# build-ext.sh, без которых `./build.sh` из свежего клона не работает. Строка
# `build/` их и прятала: сборка собиралась только там, где эти файлы уже лежали
# на диске, то есть у одного человека.
build/steer
build/steer-*
build/steerd
build/steerd-*
build/libmbed-*.a
# Разделяемая раскладка (шаг 4 выпуска 1.10): выход build/build-libs.sh по архитектурам, временные
# объекты списков экспорта и хостовая сборка стенда tests/libs-test.sh.
build/libs/
build/libs-exports/
build/libs-host/
build/libs-host.*
build/*-libs.log
build/*.err
build/pkg/
build/scripts/
out/
build/sing-box
build/bench-*
build/cstorm-*
build/hget-*
build/res-*
build/tmo-*
build/tun-gso-*
build/gcm-size
# Собранные стенды `make test`, которым Makefile велит лежать в build/. Один из них
# (build/dcmatch) однажды уехал в репозиторий вместе с правкой моста и с тех пор
# менялся в каждом коммите, который трогал tgws.c: собранный файл в истории — это
# бинарный дифф на ровном месте и лишний повод для конфликта (I-237).
build/dcmatch
build/msgsplitmatch
build/warmmatch
build/upmatch
build/tgwsfailmatch
build/bench
build/dnsmatch
build/specmatch
build/failovermatch
build/rrkeepmatch
build/runmatch
build/helpersmatch
build/pqfallbackmatch
build/dupfragmatch
build/h2match
build/submatch
build/hy2match
build/subfetchmatch
build/fwmatch
build/obfsmatch
build/visionmatch
build/tlsprobematch
build/specmatch-ext
build/awgmatch
build/awgmatch-android
build/irmatch
build/srsunit
build/modelmatch
build/irmatch-android
build/xswirematch
build/xsstreammatch
build/xsepochmatch
build/tungromatch
build/tunnelmatch
build/xhupmatch
build/grpcmatch
build/wsmatch
build/tunnamematch
build/xsconfmatch
build/xsroutematch
build/chellomatch
build/hellofreeze
build/xsloop
build/spokematch
build/hubmatch
build/xsbench
build/steer-hub
build/steer-ext
build/transportcost
# Родной скрипт OpenWrt, качается сборкой при первом запуске (см. build.sh).
build/ipkg-build
# Дерево архива серверной половины: собирается из build/steer-<арх> и server/.
build/obfs-*
build/diagsim
build/tgwssim
build/crypto-vec
build/bx-*
# wolfSSL стендов расширенной части (tests/ext-test.sh): исходники и архив под хост
build/wolfssl-host/
build/ngtcp2-host/
# Стенды QUIC (tests/ext-test.sh): собираются рядом, в дерево не входят.
build/qcbench
build/qcbrutal
build/qcloop
build/qcbatch
build/qcserver
# Архивы wolfSSL под цели сборки (build/build-ext.sh, build/bench.sh, рецепт SDK)
build/wolfssl-obj/
build/bench-*
build/xsbench-*
build/ext-sym
build/scryptomatch
build/scryptomatch-own
build/cpmatch
build/xsepochmatch
build/steer-hub-native
build/asan-probe*
build/devupmatch
build/vlessmatch
build/androidroots
build/stgws-*
build/msgsplitmatch
build/hwidsum
build/warmmatch
build/evmatch
build/yamlmatch
build/reconmatch
build/platmatch
build/ndk/
build/ndk-*.log
build/nftvmap-tool
build/urltestmatch
build/nftvmapmatch
build/groupsmatch
# Сборка архивов для VPS (build.sh): каталоги раскладки хаба и обфускации, и стенды и пробы,
# однажды уехавшие в репозиторий вместе с правками (бинарник хаба с прежними адресами в нём жил
# с d278b90).
build/hub-*/
build/obfs-*/
build/uprobe-*
build/xsconnmatch
build/xslinkmatch
# Стенды make test и ext-test, которых в списке не было (дерево после прогона оставалось грязным).
build/b3match
