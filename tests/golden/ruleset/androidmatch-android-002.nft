# args: apply --dry-run --spec TMP/spec.yaml --state-dir TMP/state
# exit: 0
# env: STEER_NFT_COMPAT=legacy-min
# stderr: steer[info] apply: ядро без nat в семействе inet — правила собраны для nftables старого ядра: таблицы inet и ip
# stderr: steer[warn] apply: ядро не умеет nat для IPv6: запросы DNS клиентов по IPv6 идут мимо резолвера ядра steer, и доменные каналы видят только тех, кто спрашивает по IPv4
# stderr: steer[warn] apply: ядро не умеет nat для IPv6: у доменных правил fake-IP нет IPv6 — на запросы AAAA их имён ответ пустой, и клиенты ходят к этим сайтам по IPv4
table inet steer {
    set vpn_dom {
        type ipv4_addr
        flags timeout
    }
    set vpn_dom_n {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "rndis0" ip daddr @vpn_dom_n meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark counter return comment "steer:vpn_dom"
        iifname "rndis0" ip daddr @vpn_dom meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark counter return comment "steer:vpn_dom"
    }

    set failopen {
        type mark
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "rndis0" ip saddr @vpn_dom_n counter comment "steer-down:vpn_dom"
        oifname "rndis0" ip saddr @vpn_dom counter comment "steer-down:vpn_dom"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0fc00000 == 0x00000000 return
        meta mark and 0x0fc00000 @failopen return
        meta mark and 0x0fc00000 == 0x00400000 oifname != "wg0" counter drop comment "steer-guard:vpn"
    }
}
table ip steer {
    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    chain prerouting_nat {
        type nat hook prerouting priority dstnat - 1; policy accept;
        iifname "rndis0" udp dport 53 counter redirect to :5300
        iifname "rndis0" tcp dport 53 counter redirect to :5300
        ip daddr 198.18.0.0/15 counter dnat to ip daddr map @fakeip
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
    }
    chain postrouting_nat {
        type nat hook postrouting priority srcnat + 1; policy accept;
    }
}
