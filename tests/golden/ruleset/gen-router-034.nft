# args: apply --dry-run --spec TMP/any-dev.json --state-dir TMP/state-any
# exit: 0
# env: STEER_NFT_INGRESS=0
# env: STEER_PLUGINS_ETC=TMP/plugetc
# env: STEER_PLUGINS_ROOT=TMP/plugins
table inet steer {
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        ip saddr { 192.168.1.50 } meta mark set mark and 0xf00fffff or 0x40100000 counter return comment "steer:zt_all_c0"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        ip daddr { 192.168.1.50 } counter comment "steer-down:zt_all_c0"
    }

    chain plugin_prerouting-dnat {
        type nat hook prerouting priority dstnat + 1; policy accept;
        jump plugin_tgws_prerouting-dnat
    }

    chain plugin_tgws_prerouting-dnat {
        meta mark and 0x0ff00000 == 0x00100000 tcp dport { 443, 80, 5222 } counter redirect to :10481 comment "steer:plugin:tgws:zt"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "br-lan" udp dport 53 counter redirect to :5300
        iifname "br-lan" tcp dport 53 counter redirect to :5300
    }
}
