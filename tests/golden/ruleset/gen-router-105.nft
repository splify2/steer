# args: apply --dry-run --spec TMP/ord3.yaml --state-dir TMP/st-ord
# exit: 0
# env: STEER_NFT_INGRESS=0
# env: STEER_PLUGINS_ETC=TMP/plugetc
# env: STEER_PLUGINS_ROOT=TMP/plugins
table inet steer {
    set A_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 10.1.0.0/16 }
    }
    set B_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 10.1.2.0/24 }
    }
    set A_ip_s2 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 10.1.2.0/24, 10.3.0.0/16 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "steer-nolan0" ip daddr @A_ip meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:A_ip"
        iifname "steer-nolan0" ip daddr @B_ip meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:B_ip"
        iifname "steer-nolan0" ip daddr @A_ip_s2 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:A_ip_s2"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "steer-nolan0" ip saddr @A_ip counter comment "steer-down:A_ip"
        oifname "steer-nolan0" ip saddr @B_ip counter comment "steer-down:B_ip"
        oifname "steer-nolan0" ip saddr @A_ip_s2 counter comment "steer-down:A_ip_s2"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 return
        meta mark and 0x0ff00000 == 0x00100000 oifname != "wg1" counter drop comment "steer-guard:A"
        meta mark and 0x0ff00000 == 0x00200000 oifname != "wg2" counter drop comment "steer-guard:B"
    }
    chain postrouting_nat4 {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wg1" meta nfproto ipv4 counter masquerade comment "steer-nat4:A"
        oifname "wg2" meta nfproto ipv4 counter masquerade comment "steer-nat4:B"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "steer-nolan0" udp dport 53 counter redirect to :5300
        iifname "steer-nolan0" tcp dport 53 counter redirect to :5300
    }
}
