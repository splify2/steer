# args: apply --dry-run --spec TMP/spec.yaml --state-dir TMP/st-full
# exit: 0
# env: STEER_NFT_INGRESS=all
table inet steer {
    set tg_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 149.154.160.0/20, 91.108.4.0/22 }
    }
    chain ingress_mark {
        type filter hook ingress device "br-lan" priority filter + 10; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 meta mark set mark and 0xf00fffff or 0x0f000000 comment "steer-ingress"
        iifname "br-lan" ip daddr @tg_ip meta mark set mark and 0xf00fffff or 0x40100000 counter return comment "steer:tg_ip"
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "br-lan" meta mark and 0x0ff00000 vmap { 0x0f000000 : goto ingress_seen, 0x00100000 : return } comment "steer-ingress"
        iifname "br-lan" ip daddr @tg_ip meta mark set mark and 0xf00fffff or 0x40100000 counter return comment "steer:tg_ip"
    }
    chain ingress_seen {
        meta mark set mark and 0xf00fffff
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "br-lan" ip saddr @tg_ip counter comment "steer-down:tg_ip"
    }

    chain tgws_redirect {
        type nat hook prerouting priority dstnat + 1; policy accept;
        meta mark and 0x0ff00000 == 0x00100000 tcp dport { 443, 80, 5222 } counter redirect to :8480 comment "steer:tgws:tg"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "br-lan" udp dport 53 counter redirect to :5300
        iifname "br-lan" tcp dport 53 counter redirect to :5300
    }
}
