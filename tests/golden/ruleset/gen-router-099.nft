# args: apply --dry-run --spec TMP/ing-nodev.yaml --state-dir TMP/st-ing
# exit: 0
# env: STEER_NFT_INGRESS=0
table inet steer {
    set dir_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 198.51.100.5 }
    }
    set fast_dom {
        type ipv4_addr
        flags interval,timeout
        auto-merge
        elements = { 10.20.0.0/16 }
    }
    set fast_dom6 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
        elements = { 2001:db8:20::/48 }
    }
    set res_ip_c2_p1 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 10.20.0.0/16 }
    }
    set res_ip_c2_p16 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:20::/48 }
    }
    set dpi_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 198.51.100.5 }
    }
    set tg_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 149.154.160.0/20 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "nosuch-steer0" ip daddr @dir_ip counter return comment "steer:dir_ip"
        ether saddr { aa:bb:cc:dd:ee:01 } meta mark set mark and 0xf00fffff or 0x40300000 ct mark set mark counter return comment "steer:res_all_c1"
        iifname "nosuch-steer0" ip daddr @fast_dom meta mark set mark and 0xf00fffff or 0x40400000 ct mark set mark counter return comment "steer:fast_dom"
        iifname "nosuch-steer0" ip6 daddr @fast_dom6 meta mark set mark and 0xf00fffff or 0x40400000 ct mark set mark counter return comment "steer:fast_dom"
        ip saddr { 192.168.1.50 } meta l4proto udp th dport 50000-65535 ip daddr @res_ip_c2_p1 meta mark set mark and 0xf00fffff or 0x40300000 ct mark set mark counter return comment "steer:res_ip_c2_p1"
        ip6 saddr { fd00::50 } meta l4proto udp th dport 50000-65535 ip6 daddr @res_ip_c2_p16 meta mark set mark and 0xf00fffff or 0x40300000 ct mark set mark counter return comment "steer:res_ip_c2_p1"
        ip saddr { 192.168.1.50 } counter goto bal_304 comment "steer:bal_all_c2"
        ip6 saddr { fd00::50 } counter goto bal_304 comment "steer:bal_all_c2"
        iifname "nosuch-steer0" ip daddr @dpi_ip meta mark set mark and 0xf00fffff or 0x40600000 ct mark set mark counter return comment "steer:dpi_ip"
        iifname "nosuch-steer0" ip daddr @tg_ip meta mark set mark and 0xf00fffff or 0x40700000 counter return comment "steer:tg_ip"
    }

    map balmap_304 {
        type mark : verdict;
        elements = { 0 : goto mark_300, 1 : goto mark_300, 2 : goto mark_300, 3 : goto mark_300, 4 : goto mark_300, 5 : goto mark_300, 6 : goto mark_300, 7 : goto mark_300, 8 : goto mark_300, 9 : goto mark_300, 10 : goto mark_300, 11 : goto mark_300, 12 : goto mark_300, 13 : goto mark_300, 14 : goto mark_300, 15 : goto mark_300, 16 : goto mark_300, 17 : goto mark_300, 18 : goto mark_300, 19 : goto mark_300, 20 : goto mark_300, 21 : goto mark_300, 22 : goto mark_300, 23 : goto mark_300, 24 : goto mark_300, 25 : goto mark_300, 26 : goto mark_300, 27 : goto mark_300, 28 : goto mark_300, 29 : goto mark_300, 30 : goto mark_300, 31 : goto mark_300, 32 : goto mark_300, 33 : goto mark_300, 34 : goto mark_300, 35 : goto mark_300, 36 : goto mark_300, 37 : goto mark_300, 38 : goto mark_300, 39 : goto mark_300, 40 : goto mark_300, 41 : goto mark_300, 42 : goto mark_300, 43 : goto mark_300, 44 : goto mark_300, 45 : goto mark_300, 46 : goto mark_300, 47 : goto mark_300, 48 : goto mark_300, 49 : goto mark_300, 50 : goto mark_300, 51 : goto mark_300, 52 : goto mark_300, 53 : goto mark_300, 54 : goto mark_300, 55 : goto mark_300, 56 : goto mark_300, 57 : goto mark_300, 58 : goto mark_300, 59 : goto mark_300, 60 : goto mark_301, 61 : goto mark_301, 62 : goto mark_301, 63 : goto mark_301, 64 : goto mark_301, 65 : goto mark_301, 66 : goto mark_301, 67 : goto mark_301, 68 : goto mark_301, 69 : goto mark_301, 70 : goto mark_301, 71 : goto mark_301, 72 : goto mark_301, 73 : goto mark_301, 74 : goto mark_301, 75 : goto mark_301, 76 : goto mark_301, 77 : goto mark_301, 78 : goto mark_301, 79 : goto mark_301, 80 : goto mark_301, 81 : goto mark_301, 82 : goto mark_301, 83 : goto mark_301, 84 : goto mark_301, 85 : goto mark_301, 86 : goto mark_301, 87 : goto mark_301, 88 : goto mark_301, 89 : goto mark_301, 90 : goto mark_301, 91 : goto mark_301, 92 : goto mark_301, 93 : goto mark_301, 94 : goto mark_301, 95 : goto mark_301, 96 : goto mark_301, 97 : goto mark_301, 98 : goto mark_301, 99 : goto mark_301, 100 : goto mark_301, 101 : goto mark_301, 102 : goto mark_301, 103 : goto mark_301, 104 : goto mark_301, 105 : goto mark_301, 106 : goto mark_301, 107 : goto mark_301, 108 : goto mark_301, 109 : goto mark_301, 110 : goto mark_301, 111 : goto mark_301, 112 : goto mark_301, 113 : goto mark_301, 114 : goto mark_301, 115 : goto mark_301, 116 : goto mark_301, 117 : goto mark_301, 118 : goto mark_301, 119 : goto mark_301 }
    }
    chain bal_304 {
        ct mark and 0x0ff00000 == 0x00100000 goto mark_300
        ct mark and 0x0ff00000 == 0x00200000 goto mark_301
        numgen random mod 120 vmap @balmap_304 comment "steer-balance:bal"
        goto mark_304
    }
    chain mark_300 {
        meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark comment "steer-mark:wg0"
    }
    chain mark_301 {
        meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark comment "steer-mark:wg1"
    }
    chain mark_304 {
        meta mark set mark and 0xf00fffff or 0x40500000 ct mark set mark comment "steer-mark:bal"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "nosuch-steer0" ip saddr @dir_ip counter comment "steer-down:dir_ip"
        ether daddr { aa:bb:cc:dd:ee:01 } counter comment "steer-down:res_all_c1"
        oifname "nosuch-steer0" ip saddr @fast_dom counter comment "steer-down:fast_dom"
        oifname "nosuch-steer0" ip6 saddr @fast_dom6 counter comment "steer-down:fast_dom"
        ip daddr { 192.168.1.50 } meta l4proto udp th sport 50000-65535 ip saddr @res_ip_c2_p1 counter comment "steer-down:res_ip_c2_p1"
        ip6 daddr { fd00::50 } meta l4proto udp th sport 50000-65535 ip6 saddr @res_ip_c2_p16 counter comment "steer-down:res_ip_c2_p1"
        ip daddr { 192.168.1.50 } counter comment "steer-down:bal_all_c2"
        ip6 daddr { fd00::50 } counter comment "steer-down:bal_all_c2"
        oifname "nosuch-steer0" ip saddr @dpi_ip counter comment "steer-down:dpi_ip"
        oifname "nosuch-steer0" ip saddr @tg_ip counter comment "steer-down:tg_ip"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 return
        meta mark and 0x0ff00000 == 0x00100000 oifname != "wg0" counter drop comment "steer-guard:wg0"
        meta mark and 0x0ff00000 == 0x00200000 oifname != "wg1" counter drop comment "steer-guard:wg1"
        meta mark and 0x0ff00000 == 0x00300000 oifname != { "wg0", "wg1" } counter drop comment "steer-guard:res"
        meta mark and 0x0ff00000 == 0x00400000 oifname != { "wg0", "wg1" } counter drop comment "steer-guard:fast"
        meta mark and 0x0ff00000 == 0x00500000 oifname != { "wg0", "wg1" } counter drop comment "steer-guard:bal"
    }

    chain zapret_queue {
        type filter hook postrouting priority srcnat + 2; policy accept;
        meta mark and 0x20000000 == 0x20000000 counter return comment "steer:zapret-own"
        ct mark and 0x0ff00000 == 0x00600000 ct original packets 1-9 meta mark set mark and 0xbfffffff counter queue num 8305 comment "steer:zapret:dpi"
    }

    chain zapret_queue_in {
        type filter hook prerouting priority mangle; policy accept;
        ct mark and 0x0ff00000 == 0x00600000 ct reply packets 1-3 counter queue num 8305 bypass comment "steer:zapret-reply:dpi"
    }

    chain zapret_predefrag {
        type filter hook output priority -401; policy accept;
        meta mark and 0x40000000 != 0x00000000 jump zapret_predefrag_nfqws comment "steer:zapret-notrack"
    }
    chain zapret_predefrag_nfqws {
        ip frag-off and 0x1fff != 0x0 notrack comment "ipfrag"
        exthdr frag exists notrack comment "ipfrag"
        tcp flags ! syn,rst,ack notrack comment "datanoack"
    }

    chain tgws_redirect {
        type nat hook prerouting priority dstnat + 1; policy accept;
        meta mark and 0x0ff00000 == 0x00700000 tcp dport { 443, 80, 5222 } counter redirect to :8486 comment "steer:tgws:tg"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "nosuch-steer0" udp dport 53 counter redirect to :5300
        iifname "nosuch-steer0" tcp dport 53 counter redirect to :5300
    }

    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    map fakeip6 {
        type ipv6_addr : ipv6_addr;
    }
    chain prerouting_dnat {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 198.18.0.0/15 counter dnat ip to ip daddr map @fakeip
        ip6 daddr fdfe:dcba:9876::/96 counter dnat ip6 to ip6 daddr map @fakeip6
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
        ip6 daddr fdfe:dcba:9876::/96 counter drop comment "steer-fakeip-nomap"
    }
}
