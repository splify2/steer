# args: apply --dry-run --spec TMP/fo.json --state-dir TMP/state-f
# exit: 0
# env: STEER_NFT_INGRESS=0
table inet steer {
    set o_dom {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set o_dom6 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "br-lan" ip daddr @o_dom counter goto bal_300 comment "steer:o_dom"
        iifname "br-lan" ip6 daddr @o_dom6 counter goto bal_300 comment "steer:o_dom"
    }

    map balmap_300 {
        type mark : verdict;
        elements = { 0 : goto mark_301 }
    }
    chain bal_300 {
        ct mark and 0x0ff00000 == 0x00200000 goto mark_301
        ct mark and 0x0ff00000 == 0x00300000 goto mark_302
        numgen inc mod 1 vmap @balmap_300 comment "steer-pin:o"
        goto mark_300
    }
    chain mark_301 {
        meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark comment "steer-mark:o.wg0"
    }
    chain mark_302 {
        meta mark set mark and 0xf00fffff or 0x40300000 ct mark set mark comment "steer-mark:o.wg1"
    }
    chain mark_300 {
        meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark comment "steer-mark:o"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "br-lan" ip saddr @o_dom counter comment "steer-down:o_dom"
        oifname "br-lan" ip6 saddr @o_dom6 counter comment "steer-down:o_dom"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 return
        meta mark and 0x0ff00000 == 0x00100000 oifname != { "wg0", "wg1" } counter drop comment "steer-guard:o"
        meta mark and 0x0ff00000 == 0x00200000 oifname != "wg0" counter drop comment "steer-guard:o.wg0"
        meta mark and 0x0ff00000 == 0x00300000 oifname != "wg1" counter drop comment "steer-guard:o.wg1"
    }
    chain postrouting_nat4 {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wg0" meta nfproto ipv4 counter masquerade comment "steer-nat4:o.wg0"
        oifname "wg1" meta nfproto ipv4 counter masquerade comment "steer-nat4:o.wg1"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "br-lan" udp dport 53 counter redirect to :5300
        iifname "br-lan" tcp dport 53 counter redirect to :5300
    }

    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    map fakeip6 {
        type ipv6_addr : ipv6_addr;
    }
    chain prerouting_dnat {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 198.18.0.0/15 counter dnat ip to ip daddr map @fakeip
        ip6 daddr fdfe:dcba:9876::/96 counter dnat ip6 to ip6 daddr map @fakeip6
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
        ip6 daddr fdfe:dcba:9876::/96 counter drop comment "steer-fakeip-nomap"
    }
}
