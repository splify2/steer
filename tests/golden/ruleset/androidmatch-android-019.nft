# args: apply --dry-run --spec TMP/spec.json --state-dir TMP/state
# exit: 0
# env: STEER_NFT_COMPAT=modern
# env: STEER_NFT_INGRESS=all
table inet steer {
    set vpn_dom {
        type ipv4_addr
        flags interval,timeout
        auto-merge
        elements = { 203.0.113.0/24 }
    }
    set vpn_dom6 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "rndis0" ip daddr @vpn_dom meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark counter return comment "steer:vpn_dom"
        iifname "rndis0" ip6 daddr @vpn_dom6 meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark counter return comment "steer:vpn_dom"
    }

    set failopen {
        type mark
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "rndis0" ip saddr @vpn_dom counter comment "steer-down:vpn_dom"
        oifname "rndis0" ip6 saddr @vpn_dom6 counter comment "steer-down:vpn_dom"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0fc00000 == 0x00000000 return
        meta mark and 0x0fc00000 @failopen return
        meta mark and 0x0fc00000 == 0x00400000 oifname != "wg0" counter drop comment "steer-guard:vpn"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "rndis0" udp dport 53 counter redirect to :5300
        iifname "rndis0" tcp dport 53 counter redirect to :5300
    }

    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    map fakeip6 {
        type ipv6_addr : ipv6_addr;
    }
    chain prerouting_dnat {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 198.18.0.0/15 counter dnat ip to ip daddr map @fakeip
        ip6 daddr fdfe:dcba:9876::/96 counter dnat ip6 to ip6 daddr map @fakeip6
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
        ip6 daddr fdfe:dcba:9876::/96 counter drop comment "steer-fakeip-nomap"
    }
    chain postrouting_fakeguard {
        type filter hook postrouting priority filter; policy accept;
        ip daddr 198.18.0.0/15 oifname { "tailscale*", "zt*", "rndis0" } counter drop comment "steer-fakeip-guard"
        ip6 daddr fdfe:dcba:9876::/96 oifname { "tailscale*", "zt*", "rndis0" } counter drop comment "steer-fakeip-guard"
    }
}
