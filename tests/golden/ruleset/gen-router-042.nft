# args: apply --dry-run --spec TMP/lan.json --state-dir TMP/state-lan
# exit: 0
# env: STEER_NFT_INGRESS=0
# env: STEER_PLUGINS_ETC=TMP/plugetc
# env: STEER_PLUGINS_ROOT=TMP/plugins
table inet steer {
    set vpn_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24, 198.51.100.5 }
    }
    set geo_dom {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set geo_dom6 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname { "br-lan", "tailscale0", "ztrq4abcde" } ip daddr @vpn_ip meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:vpn_ip"
        iifname { "br-lan", "tailscale0", "ztrq4abcde" } ip daddr @geo_dom meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:geo_dom"
        iifname { "br-lan", "tailscale0", "ztrq4abcde" } ip6 daddr @geo_dom6 meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:geo_dom"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname { "br-lan", "tailscale0", "ztrq4abcde" } ip saddr @vpn_ip counter comment "steer-down:vpn_ip"
        oifname { "br-lan", "tailscale0", "ztrq4abcde" } ip saddr @geo_dom counter comment "steer-down:geo_dom"
        oifname { "br-lan", "tailscale0", "ztrq4abcde" } ip6 saddr @geo_dom6 counter comment "steer-down:geo_dom"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 return
        meta mark and 0x0ff00000 == 0x00100000 oifname != "wg0" counter drop comment "steer-guard:vpn"
        meta mark and 0x0ff00000 == 0x00200000 oifname != "tun0" counter drop comment "steer-guard:geo"
    }
    chain postrouting_nat4 {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wg0" meta nfproto ipv4 counter masquerade comment "steer-nat4:vpn"
        oifname "tun0" meta nfproto ipv4 counter masquerade comment "steer-nat4:geo"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname { "br-lan", "tailscale0", "ztrq4abcde" } udp dport 53 counter redirect to :5300
        iifname { "br-lan", "tailscale0", "ztrq4abcde" } tcp dport 53 counter redirect to :5300
    }

    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    map fakeip6 {
        type ipv6_addr : ipv6_addr;
    }
    chain prerouting_dnat {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 198.18.0.0/15 counter dnat ip to ip daddr map @fakeip
        ip6 daddr fdfe:dcba:9876::/96 counter dnat ip6 to ip6 daddr map @fakeip6
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
        ip6 daddr fdfe:dcba:9876::/96 counter drop comment "steer-fakeip-nomap"
    }
    chain postrouting_fakeguard {
        type filter hook postrouting priority filter; policy accept;
        ip daddr 198.18.0.0/15 oifname { "tailscale*", "zt*", "br-lan", "tailscale0", "ztrq4abcde" } counter drop comment "steer-fakeip-guard"
        ip6 daddr fdfe:dcba:9876::/96 oifname { "tailscale*", "zt*", "br-lan", "tailscale0", "ztrq4abcde" } counter drop comment "steer-fakeip-guard"
    }
}
