# args: apply --dry-run --spec TMP/h6n.yaml --state-dir TMP/st-h6
# exit: 0
# env: STEER_NFT_INGRESS=0
# env: STEER_PLUGINS_ETC=TMP/plugetc
# env: STEER_PLUGINS_ROOT=TMP/plugins
table inet steer {
    set host_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24 }
    }
    set host_ip6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:a::/48 }
    }
    set other_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 198.51.100.0/24 }
    }
    set other_ip6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:b::/48 }
    }
    set dir_ip {
        type ipv4_addr
        flags interval
        auto-merge
    }
    set dir_ip6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:c::/48 }
    }
    set host_dom_s2 {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set host_dom_s26 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
    }
    set other_dom_s2 {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set other_dom_s26 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "steer-nolan0" ip daddr @host_ip meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_ip"
        iifname "steer-nolan0" ip6 daddr @host_ip6 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_ip"
        iifname "steer-nolan0" ip daddr @other_ip meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_ip"
        iifname "steer-nolan0" ip6 daddr @other_ip6 meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_ip"
        iifname "steer-nolan0" ip daddr @dir_ip counter return comment "steer:dir_ip"
        iifname "steer-nolan0" ip6 daddr @dir_ip6 counter return comment "steer:dir_ip"
        iifname "steer-nolan0" ip daddr @host_dom_s2 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_dom_s2"
        iifname "steer-nolan0" ip6 daddr @host_dom_s26 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_dom_s2"
        iifname "steer-nolan0" ip daddr @other_dom_s2 meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_dom_s2"
        iifname "steer-nolan0" ip6 daddr @other_dom_s26 meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_dom_s2"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "steer-nolan0" ip saddr @host_ip counter comment "steer-down:host_ip"
        oifname "steer-nolan0" ip6 saddr @host_ip6 counter comment "steer-down:host_ip"
        oifname "steer-nolan0" ip saddr @other_ip counter comment "steer-down:other_ip"
        oifname "steer-nolan0" ip6 saddr @other_ip6 counter comment "steer-down:other_ip"
        oifname "steer-nolan0" ip saddr @dir_ip counter comment "steer-down:dir_ip"
        oifname "steer-nolan0" ip6 saddr @dir_ip6 counter comment "steer-down:dir_ip"
        oifname "steer-nolan0" ip saddr @host_dom_s2 counter comment "steer-down:host_dom_s2"
        oifname "steer-nolan0" ip6 saddr @host_dom_s26 counter comment "steer-down:host_dom_s2"
        oifname "steer-nolan0" ip saddr @other_dom_s2 counter comment "steer-down:other_dom_s2"
        oifname "steer-nolan0" ip6 saddr @other_dom_s26 counter comment "steer-down:other_dom_s2"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 return
        meta mark and 0x0ff00000 == 0x00100000 oifname != "wg1" counter drop comment "steer-guard:host"
        meta mark and 0x0ff00000 == 0x00200000 oifname != "wg2" counter drop comment "steer-guard:other"
    }
    chain postrouting_nat6 {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wg1" meta nfproto ipv6 counter masquerade comment "steer-nat6:host"
        oifname "wg2" meta nfproto ipv6 counter masquerade comment "steer-nat6:other"
    }
    chain postrouting_nat4 {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wg1" meta nfproto ipv4 counter masquerade comment "steer-nat4:host"
        oifname "wg2" meta nfproto ipv4 counter masquerade comment "steer-nat4:other"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "steer-nolan0" udp dport 53 counter redirect to :5300
        iifname "steer-nolan0" tcp dport 53 counter redirect to :5300
    }

    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    map fakeip6 {
        type ipv6_addr : ipv6_addr;
    }
    chain prerouting_dnat {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 198.18.0.0/15 counter dnat ip to ip daddr map @fakeip
        ip6 daddr fdfe:dcba:9876::/96 counter dnat ip6 to ip6 daddr map @fakeip6
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
        ip6 daddr fdfe:dcba:9876::/96 counter drop comment "steer-fakeip-nomap"
    }
    chain postrouting_fakeguard {
        type filter hook postrouting priority filter; policy accept;
        ip daddr 198.18.0.0/15 oifname { "tailscale*", "zt*", "steer-nolan0" } counter drop comment "steer-fakeip-guard"
        ip6 daddr fdfe:dcba:9876::/96 oifname { "tailscale*", "zt*", "steer-nolan0" } counter drop comment "steer-fakeip-guard"
    }
}
