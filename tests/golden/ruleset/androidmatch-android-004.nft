# args: apply --dry-run --spec TMP/local.json --state-dir TMP/state
# exit: 0
table inet steer {
    set vpn_ip_c0 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
    }

    chain output_mark {
        type route hook output priority mangle + 1; policy accept;
        meta mark and 0x0fc00000 == 0x00000000 meta skuid 10123 ct direction original ip daddr @vpn_ip_c0 meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark counter return comment "steer:vpn_ip_c0"
    }

    chain input_down {
        type filter hook input priority filter + 10; policy accept;
        ct direction reply ct mark and 0x0fc00000 == 0x00400000 ip saddr @vpn_ip_c0 counter comment "steer-down:vpn_ip_c0"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0fc00000 == 0x00000000 return
        meta mark and 0x0fc00000 == 0x00400000 oifname != "wg0" counter drop comment "steer-guard:vpn"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "rndis0" udp dport 53 counter redirect to :5300
        iifname "rndis0" tcp dport 53 counter redirect to :5300
    }
}
