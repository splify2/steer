# args: apply --dry-run --spec TMP/h6.yaml --state-dir TMP/state
# exit: 0
# env: STEER_NFT_COMPAT=modern
# stderr: steer[warn] apply: output wg: ipv6: routed на этой платформе не действует — раздачей IPv6 владеет Android, IPv6 выхода идёт как без ключа
table inet steer {
    set wg_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24 }
    }
    set wg_ip6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:a::/48 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "br-lan" ip daddr @wg_ip meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark counter return comment "steer:wg_ip"
        iifname "br-lan" ip6 daddr @wg_ip6 meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark counter return comment "steer:wg_ip"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "br-lan" ip saddr @wg_ip counter comment "steer-down:wg_ip"
        oifname "br-lan" ip6 saddr @wg_ip6 counter comment "steer-down:wg_ip"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0fc00000 == 0x00000000 return
        meta mark and 0x0fc00000 == 0x00400000 oifname != "wg0" counter drop comment "steer-guard:wg"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "br-lan" udp dport 53 counter redirect to :5300
        iifname "br-lan" tcp dport 53 counter redirect to :5300
    }
}
