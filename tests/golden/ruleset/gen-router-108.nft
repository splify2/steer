# args: apply --dry-run --spec TMP/h6n.yaml --state-dir TMP/st-h6
# exit: 0
# env: STEER_NFT_COMPAT=legacy
# env: STEER_NFT_INGRESS=0
# stderr: steer[info] apply: ядро без nat в семействе inet — правила собраны для nftables старого ядра: таблицы inet и ip и ip6
table inet steer {
    set host_dom {
        type ipv4_addr
        flags timeout
    }
    set host_dom_n {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24 }
    }
    set host_dom6 {
        type ipv6_addr
        flags timeout
    }
    set host_dom6_n {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:a::/48 }
    }
    set other_dom {
        type ipv4_addr
        flags timeout
    }
    set other_dom_n {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 198.51.100.0/24 }
    }
    set other_dom6 {
        type ipv6_addr
        flags timeout
    }
    set other_dom6_n {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:b::/48 }
    }
    set dir_ip {
        type ipv4_addr
        flags interval
        auto-merge
    }
    set dir_ip6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8:c::/48 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "steer-nolan0" ip daddr @host_dom_n meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_dom"
        iifname "steer-nolan0" ip daddr @host_dom meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_dom"
        iifname "steer-nolan0" ip6 daddr @host_dom6_n meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_dom"
        iifname "steer-nolan0" ip6 daddr @host_dom6 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:host_dom"
        iifname "steer-nolan0" ip daddr @other_dom_n meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_dom"
        iifname "steer-nolan0" ip daddr @other_dom meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_dom"
        iifname "steer-nolan0" ip6 daddr @other_dom6_n meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_dom"
        iifname "steer-nolan0" ip6 daddr @other_dom6 meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:other_dom"
        iifname "steer-nolan0" ip daddr @dir_ip counter return comment "steer:dir_ip"
        iifname "steer-nolan0" ip6 daddr @dir_ip6 counter return comment "steer:dir_ip"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "steer-nolan0" ip saddr @host_dom_n counter comment "steer-down:host_dom"
        oifname "steer-nolan0" ip saddr @host_dom counter comment "steer-down:host_dom"
        oifname "steer-nolan0" ip6 saddr @host_dom6_n counter comment "steer-down:host_dom"
        oifname "steer-nolan0" ip6 saddr @host_dom6 counter comment "steer-down:host_dom"
        oifname "steer-nolan0" ip saddr @other_dom_n counter comment "steer-down:other_dom"
        oifname "steer-nolan0" ip saddr @other_dom counter comment "steer-down:other_dom"
        oifname "steer-nolan0" ip6 saddr @other_dom6_n counter comment "steer-down:other_dom"
        oifname "steer-nolan0" ip6 saddr @other_dom6 counter comment "steer-down:other_dom"
        oifname "steer-nolan0" ip saddr @dir_ip counter comment "steer-down:dir_ip"
        oifname "steer-nolan0" ip6 saddr @dir_ip6 counter comment "steer-down:dir_ip"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 return
        meta mark and 0x0ff00000 == 0x00100000 oifname != "wg1" counter drop comment "steer-guard:host"
        meta mark and 0x0ff00000 == 0x00200000 oifname != "wg2" counter drop comment "steer-guard:other"
    }
    chain postrouting_fakeguard {
        type filter hook postrouting priority filter; policy accept;
        ip daddr 198.18.0.0/15 oifname { "tailscale*", "zt*", "steer-nolan0" } counter drop comment "steer-fakeip-guard"
        ip6 daddr fdfe:dcba:9876::/96 oifname { "tailscale*", "zt*", "steer-nolan0" } counter drop comment "steer-fakeip-guard"
    }
}
table ip steer {
    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    chain prerouting_nat {
        type nat hook prerouting priority dstnat - 1; policy accept;
        iifname "steer-nolan0" udp dport 53 counter redirect to :5300
        iifname "steer-nolan0" tcp dport 53 counter redirect to :5300
        ip daddr 198.18.0.0/15 counter dnat to ip daddr map @fakeip
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
    }
    chain postrouting_nat {
        type nat hook postrouting priority srcnat + 1; policy accept;
        oifname "wg1" counter masquerade comment "steer-nat4:host"
        oifname "wg2" counter masquerade comment "steer-nat4:other"
    }
}
table ip6 steer {
    map fakeip6 {
        type ipv6_addr : ipv6_addr;
    }
    chain prerouting_nat {
        type nat hook prerouting priority dstnat - 1; policy accept;
        iifname "steer-nolan0" udp dport 53 counter redirect to :5300
        iifname "steer-nolan0" tcp dport 53 counter redirect to :5300
        ip6 daddr fdfe:dcba:9876::/96 counter dnat to ip6 daddr map @fakeip6
        ip6 daddr fdfe:dcba:9876::/96 counter drop comment "steer-fakeip-nomap"
    }
    chain postrouting_nat {
        type nat hook postrouting priority srcnat + 1; policy accept;
        oifname "wg1" counter masquerade comment "steer-nat6:host"
        oifname "wg2" counter masquerade comment "steer-nat6:other"
    }
}
