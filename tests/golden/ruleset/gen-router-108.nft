# args: apply --dry-run --spec TMP/ord6.yaml --state-dir TMP/st-ord
# exit: 0
# env: STEER_NFT_INGRESS=0
# env: STEER_PLUGINS_ETC=TMP/plugetc
# env: STEER_PLUGINS_ROOT=TMP/plugins
table inet steer {
    set A_dom_c0 {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set A_dom_c06 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
    }
    set B_dom_c1 {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set B_dom_c16 {
        type ipv6_addr
        flags interval,timeout
        auto-merge
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        ether saddr { aa:bb:cc:dd:ee:01 } ip daddr @A_dom_c0 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:A_dom_c0"
        ether saddr { aa:bb:cc:dd:ee:01 } ip6 daddr @A_dom_c06 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:A_dom_c0"
        ether saddr { aa:bb:cc:dd:ee:02 } ip daddr @B_dom_c1 meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:B_dom_c1"
        ether saddr { aa:bb:cc:dd:ee:02 } ip6 daddr @B_dom_c16 meta mark set mark and 0xf00fffff or 0x40200000 ct mark set mark counter return comment "steer:B_dom_c1"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        ether daddr { aa:bb:cc:dd:ee:01 } ip saddr @A_dom_c0 counter comment "steer-down:A_dom_c0"
        ether daddr { aa:bb:cc:dd:ee:01 } ip6 saddr @A_dom_c06 counter comment "steer-down:A_dom_c0"
        ether daddr { aa:bb:cc:dd:ee:02 } ip saddr @B_dom_c1 counter comment "steer-down:B_dom_c1"
        ether daddr { aa:bb:cc:dd:ee:02 } ip6 saddr @B_dom_c16 counter comment "steer-down:B_dom_c1"
    }
    chain postrouting_guard {
        type filter hook postrouting priority filter; policy accept;
        meta mark and 0x0ff00000 == 0x00000000 return
        meta mark and 0x0ff00000 == 0x00100000 oifname != "wg1" counter drop comment "steer-guard:A"
        meta mark and 0x0ff00000 == 0x00200000 oifname != "wg2" counter drop comment "steer-guard:B"
    }
    chain postrouting_nat4 {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wg1" meta nfproto ipv4 counter masquerade comment "steer-nat4:A"
        oifname "wg2" meta nfproto ipv4 counter masquerade comment "steer-nat4:B"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat - 2; policy accept;
        iifname "steer-nolan0" udp dport 53 counter redirect to :5300
        iifname "steer-nolan0" tcp dport 53 counter redirect to :5300
    }

    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    map fakeip6 {
        type ipv6_addr : ipv6_addr;
    }
    chain prerouting_dnat {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 198.18.0.0/15 counter dnat ip to ip daddr map @fakeip
        ip6 daddr fdfe:dcba:9876::/96 counter dnat ip6 to ip6 daddr map @fakeip6
        ip daddr 198.18.0.0/15 counter drop comment "steer-fakeip-nomap"
        ip6 daddr fdfe:dcba:9876::/96 counter drop comment "steer-fakeip-nomap"
    }
    chain postrouting_fakeguard {
        type filter hook postrouting priority filter; policy accept;
        ip daddr 198.18.0.0/15 oifname { "tailscale*", "zt*", "steer-nolan0" } counter drop comment "steer-fakeip-guard"
        ip6 daddr fdfe:dcba:9876::/96 oifname { "tailscale*", "zt*", "steer-nolan0" } counter drop comment "steer-fakeip-guard"
    }
}
