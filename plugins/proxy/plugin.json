{
  "schema": 1,
  "id": "proxy",
  "version": "@VERSION@",
  "type": "plugin",
  "name": "Прокси",
  "description": "Туннели trojan, shadowsocks, socks, http и vmess",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/splify2/steer",
  "compat": {
    "steer-api": "^1.0"
  },
  "arch": [
    "aarch64_cortex-a53",
    "aarch64_cortex-a72",
    "aarch64_generic",
    "arm_cortex-a7_neon-vfpv4",
    "arm_cortex-a9",
    "arm_cortex-a9_neon",
    "arm_cortex-a9_vfpv3-d16",
    "mipsel_24kc",
    "mips_24kc",
    "x86_64"
  ],
  "requires": {
    "system": [
      "kmod-tun"
    ],
    "kernel": [
      "/dev/net/tun"
    ],
    "plugins": {
      "net1": "^1.2"
    }
  },
  "permissions": [
    "net.admin",
    "ctl",
    "system-packages"
  ],
  "steer": {
    "kinds": [
      {
        "name": "tunnel:trojan",
        "keys": "kinds/trojan.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "events"
      },
      {
        "name": "tunnel:shadowsocks",
        "keys": "kinds/shadowsocks.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "events"
      },
      {
        "name": "tunnel:socks",
        "keys": "kinds/socks.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "events"
      },
      {
        "name": "tunnel:http",
        "keys": "kinds/http.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "events"
      },
      {
        "name": "tunnel:vmess",
        "keys": "kinds/vmess.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "events"
      }
    ],
    "commands": [
      {
        "name": "proxy-nodes",
        "prog": "bin/proxy",
        "help": "узлы подписки выхода",
        "ctl": {
          "timeout_s": 15,
          "args": [
            "name"
          ],
          "spec": true
        }
      },
      {
        "name": "proxy-probe",
        "prog": "bin/proxy",
        "help": "проверить узлы выхода",
        "ctl": {
          "timeout_s": 180,
          "args": [
            "name",
            "int",
            "int"
          ],
          "optional": 2,
          "spec": true
        }
      }
    ]
  }
}
