{
  "schema": 1,
  "id": "proxy",
  "version": "@VERSION@",
  "type": "plugin",
  "name": "Прокси",
  "description": "Туннели trojan, shadowsocks, socks, http и vmess",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/splify2/steer",
  "compat": {
    "steer-api": "^1.1"
  },
  "arch": [
    "aarch64_cortex-a53",
    "aarch64_cortex-a72",
    "aarch64_generic",
    "arm_cortex-a7_neon-vfpv4",
    "arm_cortex-a9",
    "arm_cortex-a9_neon",
    "arm_cortex-a9_vfpv3-d16",
    "mipsel_24kc",
    "mips_24kc",
    "x86_64"
  ],
  "requires": {
    "system": [
      "kmod-tun"
    ],
    "kernel": [
      "/dev/net/tun"
    ],
    "plugins": {
      "net1": "^1.3"
    }
  },
  "permissions": [
    "net.admin",
    "ctl",
    "system-packages"
  ],
  "steer": {
    "kinds": [
      {
        "name": "tunnel:trojan",
        "keys": "kinds/trojan.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "tcp",
        "description": "Туннель Trojan по подписке.",
        "check": {
          "prog": "bin/proxy",
          "argv": [
            "check"
          ]
        },
        "texts": {
          "selfnat_why": "masquerade не нужен: туннель завершает TCP сам, адреса клиентов наружу не уходят"
        }
      },
      {
        "name": "tunnel:shadowsocks",
        "keys": "kinds/shadowsocks.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "tcp",
        "description": "Туннель Shadowsocks по подписке.",
        "check": {
          "prog": "bin/proxy",
          "argv": [
            "check"
          ]
        },
        "texts": {
          "selfnat_why": "masquerade не нужен: туннель завершает TCP сам, адреса клиентов наружу не уходят"
        }
      },
      {
        "name": "tunnel:socks",
        "keys": "kinds/socks.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "tcp",
        "description": "Туннель через прокси SOCKS по подписке.",
        "check": {
          "prog": "bin/proxy",
          "argv": [
            "check"
          ]
        },
        "texts": {
          "selfnat_why": "masquerade не нужен: туннель завершает TCP сам, адреса клиентов наружу не уходят"
        }
      },
      {
        "name": "tunnel:http",
        "keys": "kinds/http.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "tcp",
        "description": "Туннель через прокси HTTP по подписке.",
        "check": {
          "prog": "bin/proxy",
          "argv": [
            "check"
          ]
        },
        "texts": {
          "selfnat_why": "masquerade не нужен: туннель завершает TCP сам, адреса клиентов наружу не уходят"
        }
      },
      {
        "name": "tunnel:vmess",
        "keys": "kinds/vmess.schema.json",
        "caps": [
          "device",
          "mark",
          "ctmark",
          "engine-owned",
          "self-nat",
          "over",
          "tcp-probe",
          "flow-udp",
          "tcp-redir",
          "ipv6"
        ],
        "helper": {
          "prog": "bin/proxy",
          "cmd": "proxy",
          "argv": [
            "proxy",
            "{out}",
            "--conf",
            "{conf}"
          ]
        },
        "health": "tcp",
        "description": "Туннель VMess по подписке.",
        "check": {
          "prog": "bin/proxy",
          "argv": [
            "check"
          ]
        },
        "texts": {
          "selfnat_why": "masquerade не нужен: туннель завершает TCP сам, адреса клиентов наружу не уходят"
        }
      }
    ],
    "commands": [
      {
        "name": "proxy-nodes",
        "prog": "bin/proxy",
        "help": "узлы подписки выхода или файла подписки (путь с «/»)",
        "usage": "<выход|/файл> [--insecure]",
        "conf": true,
        "ctl": {
          "timeout_s": 15,
          "args": [
            "name"
          ]
        }
      },
      {
        "name": "proxy-probe",
        "prog": "bin/proxy",
        "help": "проверить узел выхода и измерить задержку",
        "usage": "<выход|/файл> [--node N] [--timeout СЕК] [--insecure]",
        "conf": true,
        "ctl": {
          "timeout_s": 180,
          "args": [
            "name",
            {
              "kind": "int",
              "flag": "--node",
              "min": -1,
              "max": 9999
            },
            {
              "kind": "int",
              "flag": "--timeout",
              "min": 1,
              "max": 30
            }
          ],
          "optional": 2
        }
      }
    ]
  },
  "i18n": {
    "languages": [
      "ru",
      "en"
    ]
  }
}
