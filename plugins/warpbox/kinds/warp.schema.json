        "pattern": "^[A-Z]{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "exclude_countries": {
      "type": [
        "string",
        "array"
      ],
      "pattern": "^[A-Z]{2}$",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
