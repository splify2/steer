{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Steer experimental WireGuard TCP outbound in a disposable Linux namespace",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin", "flow", "variant", "transport", "endpoint", "options"],
  "properties": {
    "plugin": { "const": "wireguard:main" },
    "flow": { "const": ["stream"] },
    "variant": { "const": "kernel" },
    "transport": { "const": { "type": "udp" } },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "port"],
      "properties": {
        "address": { "type": "string", "format": "ipv4" },
        "port": { "$ref": "#/$defs/port" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_key", "listen_port", "addresses", "route_prefix", "peers"],
      "properties": {
        "private_key": { "$ref": "#/$defs/secret" },
        "listen_port": { "$ref": "#/$defs/port" },
        "mtu": { "type": "integer", "minimum": 1280, "maximum": 9000, "default": 1420 },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$" }
        },
        "route_prefix": { "$ref": "#/$defs/route" },
        "peers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["public_key", "principal_id", "allowed_ips"],
            "properties": {
              "public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
              "principal_id": { "$ref": "#/$defs/id" },
              "preshared_key": { "$ref": "#/$defs/secret" },
              "allowed_ips": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "$ref": "#/$defs/route" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}$" },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret"],
      "properties": { "secret": { "$ref": "#/$defs/id" } }
    },
    "route": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(2[4-9]|3[0-2])$" }
  }
}
